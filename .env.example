# ==========================================
# QuickTok Environment Configuration
# ==========================================

# --- Frontend Configuration (Vite) ---
# The backend API URL for the decoupled frontend (e.g. on Vercel/Netlify/GitHub Pages).
# Leave empty during local development or when frontend and backend share the same domain.
# Example: https://api.quicktok.online or https://quicktok-api.onrender.com
VITE_API_URL=""

# --- Backend Configuration (Node.js/Express) ---
# Server port for the Express backend. Defaults to 3000 if omitted.
PORT=3000

# The public URL of the frontend for CORS authorization.
# Example: https://quicktok.online
FRONTEND_URL="https://quicktok.online"

# Self-referential base URL for server-side generation
PUBLIC_APP_URL="https://quicktok.online"

# Optional Server-Side Media Provider:
# Leave empty to use default public extraction endpoints.
VIDEO_PROVIDER_BASE_URL=""
VIDEO_PROVIDER_API_KEY=""

# Admin Access Token:
# Secret token to protect access to the admin statistics endpoint (/api/admin/stats).
ADMIN_ACCESS_TOKEN=""

# Gemini API Key (injected by environment if needed)
GEMINI_API_KEY=""
