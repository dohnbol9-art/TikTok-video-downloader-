# QuickTok Video Downloader Configuration

# PUBLIC_APP_URL: Optional during local development. Self-referential base URL.
PUBLIC_APP_URL=""

# VIDEO_PROVIDER_BASE_URL: Required only when a real third-party processing provider is configured
# (e.g. Cobalt API, TikWM API, RapidAPI, or custom internal media proxy).
VIDEO_PROVIDER_BASE_URL=""

# VIDEO_PROVIDER_API_KEY: Server-side secret key for the configured video provider.
# NEVER exposed to the frontend or client bundles.
VIDEO_PROVIDER_API_KEY=""

# ADMIN_ACCESS_TOKEN: Server-side secret token used to access the protected admin metrics dashboard.
ADMIN_ACCESS_TOKEN=""

# Server Port (default: 3000)
PORT=3000

# GEMINI_API_KEY: Optional/Default injected by environment
GEMINI_API_KEY=""
APP_URL=""

