<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass through direct requests into dist/
  RewriteRule ^dist/ - [L]

  # If requested path exists inside dist/, serve it directly
  RewriteCond dist/$1 -f [OR]
  RewriteCond dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # Route all other requests and SPA paths to dist/index.html
  RewriteCond dist/index.html -f
  RewriteRule ^.*$ dist/index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
